{
  "name": "virtual-assistant",
  "version": "0.10.0",
  "private": true,
  "description": "Local-only desktop virtual assistant - build 0.010.19.11.26",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist:win": "npm run build && electron-builder --win --x64",
    "build:mobile": "vite build --config vite.mobile.config.mts",
    "copy:android": "node scripts/copy-mobile-assets.mjs",
    "build:android:assets": "npm run build:mobile && npm run copy:android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "three": "^0.187.0",
    "whisper.cpp": "^1.0.3",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.virtua.desktop",
    "productName": "Virtua",
    "npmRebuild": false,
    "directories": {
      "output": "dist-setup"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*",
          "!**/*.vrm",
          "!**/*.gguf",
          "!**/*.db"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Virtua-Setup-${version}-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Virtua"
    }
  }
}
